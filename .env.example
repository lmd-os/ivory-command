# ─────────────────────────────────────────────────────────────
# IVORY COMMAND — FlyTrack configuration
# Copy to .env (local) or set in Netlify dashboard (production).
# ─────────────────────────────────────────────────────────────

# Tracking mode:
#   real → public ADS-B data only (default, recommended)
#   demo → clearly-marked SIMULATED tracks (never confuse with real)
VITE_FLYTRACK_MODE=real

# Preferred primary provider when several return a position: adsb | opensky
VITE_FLIGHT_PROVIDER=adsb

# ── Server-side secrets (read by the Netlify Function only) ──────────────
# IMPORTANT: prefer the NON-VITE names below. VITE_ variables are embedded in
# the client bundle and would expose secrets publicly. The proxy accepts both
# but you should set the non-VITE names in the Netlify dashboard.

# OpenSky Network OAuth2 client credentials (https://opensky-network.org/)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Private ADS-B Exchange / RapidAPI key + base (optional; adsb.lol works keyless)
ADSB_API_KEY=
# ADSB_API_BASE=https://adsbexchange-com1.p.rapidapi.com/v2

# AviationStack (optional, paid tier required for live lat/lon)
AVIATIONSTACK_API_KEY=

# FlightRadar24 Business API (optional)
FLIGHTRADAR_API_KEY=
# FLIGHTRADAR_API_BASE=https://fr24api.flightradar24.com/api

# Manually-verified last-known fix (optional, last resort, never invented):
#   FLYTRACK_MANUAL_<HEX>="lat,lon,ISO8601[,onground]"
# FLYTRACK_MANUAL_5002D1=11.5465,43.1594,2026-06-06T18:00:00Z,onground
